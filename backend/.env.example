# Copy to .env and fill in real values. NEVER commit .env (this repo is public).
#   cp .env.example .env && php artisan key:generate

APP_NAME=Layarku
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# All timestamps are stored in UTC (config/app.php is fixed to UTC). The cinema
# time zone is used only to interpret dates (?date=2026-11-21) and build showtimes.
CINEMA_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL or PostgreSQL. Booking needs real row locks (SELECT ... FOR UPDATE),
# which SQLite does not provide.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=layarku
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# TMDB (movie data, imported via `php artisan movies:import`). v3 API key.
TMDB_API_KEY=
TMDB_REGION=ID
TMDB_LANGUAGE=en-US

# Midtrans Snap (sandbox) - used from phase 5
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Firebase Cloud Messaging (HTTP v1) - used from phase 6.
# Path to the service account JSON, stored OUTSIDE git (see root .gitignore).
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

VITE_APP_NAME="${APP_NAME}"
