# Copy to .env and fill in real values. NEVER commit .env.
# Laravel will regenerate a fuller .env.example in phase 1; the keys below are
# the project-specific ones that must be kept.

APP_NAME=Layarku
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
CINEMA_TIMEZONE=Asia/Jakarta

# MySQL or PostgreSQL (row locks are required for booking; SQLite only for quick tests)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=layarku
DB_USERNAME=
DB_PASSWORD=

QUEUE_CONNECTION=database

# TMDB (movie data, imported via `php artisan movies:import`)
TMDB_API_KEY=

# Midtrans Snap (sandbox)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Firebase Cloud Messaging (HTTP v1). Path to the service account JSON,
# stored OUTSIDE git (see .gitignore).
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
